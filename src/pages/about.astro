---
import Base from "~/layouts/Base.astro";
import SectionEyebrow from "~/components/SectionEyebrow.astro";
import { site } from "~/site.config";
import trackRecord from "~/content/homepage/trackRecord.json";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${siteUrl}/about#page`,
  url: `${siteUrl}/about`,
  name: `About — ${site.studio}`,
  description: `About ${site.founder}: independent product and AI builder, operator turned builder, working with B2B companies from Mexico City.`,
  about: { "@id": `${siteUrl}/#person` },
  mainEntity: { "@id": `${siteUrl}/#person` },
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#studio` },
};

const arc = [
  {
    period: "2019 — 2021",
    title: "Consultant, then advisor.",
    body: "MBA summer rotation inside BBVA's operations in 2019, then Senior Consultant at KoreFusion (2020 to 2021) advising on go-to-market and payments strategy for 100+ fintechs across LATAM, EMEA, and the US. The lesson that stuck: most strategy decks die because nobody owns the workflow underneath. The advisors who said 'and here's how I'd run it on Monday' got asked back.",
  },
  {
    period: "2021 — 2023",
    title: "Head of Sales, Mexico, Jeeves (YC20, a16z).",
    body: "BDM into Head of Sales for Mexico, leading GTM across five LATAM countries. Built and managed a 12-person team (+25% sales per rep in two quarters), a portfolio of 100+ clients and $15M+ in credit lines. Contributed customer-data analysis to the Series C deck (~$180M raised at a $2.1B valuation). A great product without an operator who understands the buyer's day-to-day is still just a roadmap.",
  },
  {
    period: "2023 — 2025",
    title: "Director of Strategy & Operations, Bedu (Lottus Education).",
    body: "Owned B2B P&L for the edtech arm of one of Mexico's leading higher-education groups. Managed enterprise accounts worth $300K+ each (HSBC, Santander, Novartis, Accenture), lifted B2C retention +20 points to 70%, and cut opex 15% without sacrificing quality. Enterprise buyers don't want features. They want decisions removed from their week.",
  },
  {
    period: "2025 — now",
    title: "Back to operating, then building.",
    body: "Joined MatchWise in 2025 as Director of Operations & GTM. 25+ customer interviews to nail ICP and pricing, then AI recruiting workflows that cut candidate-evaluation time 90% while reducing inference cost 60%. In 2026, partner at Clearframe Labs on B2B custom builds, with independent engagements alongside. The throughline: stop writing decks about the build. Build the thing.",
  },
];

const beliefs = [
  {
    title: "AI without a real problem under it is a demo.",
    body: "Most failed AI builds start from the technology and look for a use case. The ones that ship and stick start from a workflow that's expensive, slow, or broken, and use AI as the cheapest tool that fixes it.",
  },
  {
    title: "Ship in weeks, not quarters.",
    body: "Long roadmaps die in committee. Short cycles force the team to confront whether the thing actually works against a real user, a real workflow, and real data. Most of what's worth knowing about a build, you learn in week three.",
  },
  {
    title: "Diagnose before prescribing.",
    body: "Half the engagements I take start with the wrong problem statement. The first week is usually about narrowing the question. The build is the easy part once the question is right.",
  },
  {
    title: "One operator-builder beats a small team, until it doesn't.",
    body: "For the first version of most internal tools and automations, one person who can build and also talk to the buyer is faster than a team. The ceiling shows up around the second or third user, and that's the point to staff up, not before.",
  },
  {
    title: "Distribution eats features.",
    body: "The hardest problems in B2B are rarely technical. They are who decides, who pays, who has to change their behavior on Monday morning. The build is the easy part if you know those answers up front.",
  },
];

const whatNow = [
  {
    label: "Clearframe Labs",
    body: "Partner at clearframelabs.co. We take on custom B2B builds where the brief is messier than a standard agency engagement and the buyer wants someone who's done the operating, not just the architecture.",
  },
  {
    label: "MatchWise",
    body: "An AI applicant tracking system, bootstrapped, in active use. The product I keep building because hiring is the workflow I've felt the most operational pain inside.",
  },
  {
    label: "Independent engagements",
    body: "A small number per quarter. Usually a 4-to-8-week build, sometimes an advisory retainer that turns into a build after the first month.",
  },
];
---

<Base
  title="About"
  description={`About ${site.founder}: independent product and AI builder, operator turned builder, working with B2B companies from Mexico City.`}
  jsonLd={aboutPageSchema}
>
  <section class="mx-auto max-w-6xl px-6 pt-32 pb-16">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <SectionEyebrow class="mb-4">About</SectionEyebrow>
        <img
          src="/henrick.jpg"
          alt={`Portrait of ${site.founder}`}
          width="240"
          height="240"
          loading="lazy"
          class="mt-8 w-40 h-40 md:w-56 md:h-56 rounded-full object-cover border border-[color:var(--color-line)]"
        />
      </div>
      <div class="md:col-span-2">
        <h1 class="font-display text-5xl md:text-6xl tracking-tight leading-[1.05]">
          Operator who learned to build, then kept building.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-[color:var(--color-muted)] leading-relaxed max-w-2xl">
          I'm {site.founder}, an independent product and AI builder. I build AI automations and custom applications for B2B companies. The six years before this were spent inside venture-backed fintech, edtech, and AI startups across LATAM, which is how I know which problems are actually worth solving.
        </p>
        <p class="mt-6 text-lg leading-relaxed max-w-2xl">
          The honest version of the pitch: most AI builders don't know what a credit-ops workflow looks like at 9pm on a Friday. Most operators can't ship the tool that fixes it. I sit in that overlap, and that's the angle I bring to every engagement.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">01</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">The arc</h2>
        <p class="mt-4 text-[color:var(--color-muted)] leading-relaxed">
          How I got from running sales floors to shipping software.
        </p>
      </div>
      <div class="md:col-span-2 space-y-10 text-lg leading-relaxed text-[color:var(--color-muted)]">
        {arc.map((entry) => (
          <div class="space-y-2">
            <div class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-muted)]">{entry.period}</div>
            <h3 class="font-display text-xl text-[color:var(--color-fg)]">{entry.title}</h3>
            <p>{entry.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="max-w-2xl">
      <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">02</div>
      <h2 class="font-display text-3xl md:text-4xl tracking-tight">What I'm doing now</h2>
    </div>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
      {whatNow.map((item) => (
        <article class="rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)] p-6 md:p-8 transition-colors hover:border-[color:var(--color-fg)]/40">
          <h3 class="font-display text-xl md:text-2xl tracking-tight text-[color:var(--color-fg)]">{item.label}</h3>
          <p class="mt-3">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">03</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">What I believe</h2>
        <p class="mt-4 text-[color:var(--color-muted)] leading-relaxed">
          Five things that shape how I take on work.
        </p>
      </div>
      <div class="md:col-span-2 space-y-8 text-lg leading-relaxed text-[color:var(--color-muted)]">
        {beliefs.map((item) => (
          <div class="space-y-2">
            <h3 class="font-display text-xl text-[color:var(--color-fg)]">{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">04</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Track record</h2>
        <p class="mt-4 text-[color:var(--color-muted)] leading-relaxed">
          {trackRecord.intro}
        </p>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
          {trackRecord.companies.map((company) => (
            <li>
              <a
                href={company.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-display text-xl text-[color:var(--color-fg)] underline underline-offset-4 decoration-[color:var(--color-line)] hover:decoration-[color:var(--color-accent)]"
              >
                {company.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="pt-4 border-t border-[color:var(--color-line)]">{trackRecord.footnote}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <SectionEyebrow class="mb-3">Work together</SectionEyebrow>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Have a problem worth solving?</h2>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <p>A short email is enough to start. Tell me what you're building, what's stuck, and when you'd want to ship by.</p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact"
            class="px-6 py-3 rounded-full bg-[color:var(--color-fg)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-accent)] hover:text-[color:var(--color-bg)] transition-colors"
          >
            Get in touch
          </a>
          <a
            href="/#work"
            class="px-6 py-3 rounded-full border border-[color:var(--color-line)] hover:border-[color:var(--color-fg)] transition-colors"
          >
            See recent work →
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-12 border-t border-[color:var(--color-line)] flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-sm">
    <a href="/" class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">← Home</a>
    <a href="/contact" class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">Contact →</a>
  </div>
</Base>
