---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "~/layouts/Base.astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { data, body } = post;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const wordCount = body
  ? body.replace(/\s+/g, " ").trim().split(" ").filter(Boolean).length
  : undefined;

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}

const articleSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.excerpt,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { "@id": `${siteUrl}/#person` },
  publisher: { "@id": `${siteUrl}/#studio` },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  inLanguage: "en",
};
if (data.coverImage) {
  articleSchema.image = new URL(data.coverImage, Astro.site).toString();
}
if (wordCount) articleSchema.wordCount = wordCount;
if (data.keywords.length > 0) articleSchema.keywords = data.keywords;
if (data.about.length > 0) {
  articleSchema.about = data.about.map((name) => ({ "@type": "Thing", name }));
}
if (data.sourceUrls.length > 0) {
  articleSchema.citation = data.sourceUrls.map((u) => ({ "@type": "CreativeWork", url: u }));
}

const faqSchema = data.faqs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: data.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Writing", item: new URL("/writing", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: data.title, item: canonicalUrl },
  ],
};

const jsonLd = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Base
  title={data.title}
  description={data.excerpt}
  ogType="article"
  ogImage={data.coverImage}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-6 pt-20 pb-32">
    <a href="/writing" class="text-sm text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">
      ← All writing
    </a>

    <header class="mt-12 pb-10 border-b border-[color:var(--color-line)]">
      <div class="text-xs text-[color:var(--color-muted)] uppercase tracking-[0.2em] mb-6">
        {formatDate(data.publishedAt)} · {data.topic}
      </div>
      <h1 class="font-display text-4xl md:text-6xl tracking-tight leading-[1.05]">
        {data.title}
      </h1>
      <p class="mt-6 text-xl text-[color:var(--color-muted)] leading-relaxed">
        {data.excerpt}
      </p>
    </header>

    <div class="prose-essay mt-12 text-lg leading-[1.75]">
      <Content />
    </div>

    {data.sourceUrls.length > 0 && (
      <aside class="mt-16 pt-8 border-t border-[color:var(--color-line)]">
        <div class="text-xs text-[color:var(--color-muted)] uppercase tracking-[0.18em] mb-4">Sources</div>
        <ul class="space-y-2 text-sm">
          {data.sourceUrls.map((u) => (
            <li>
              <a href={u} target="_blank" rel="noopener noreferrer" class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] underline underline-offset-4 break-all">
                {u}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div class="mt-20 pt-12 border-t border-[color:var(--color-line)] flex justify-between items-center">
      <a href="/writing" class="text-sm text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">
        ← All writing
      </a>
      <a
        href="/#contact"
        class="px-6 py-3 rounded-full bg-[color:var(--color-fg)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-accent)] transition-colors"
      >
        Start a project
      </a>
    </div>
  </article>
</Base>

<style is:global>
  .prose-essay > * + * {
    margin-top: 1.5rem;
  }
  .prose-essay h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    color: var(--color-fg);
  }
  .prose-essay h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-fg);
  }
  .prose-essay p {
    color: var(--color-muted);
  }
  .prose-essay p:first-of-type {
    color: var(--color-fg);
  }
  .prose-essay ul,
  .prose-essay ol {
    color: var(--color-muted);
    padding-left: 1.5rem;
  }
  .prose-essay ul {
    list-style: disc;
  }
  .prose-essay ol {
    list-style: decimal;
  }
  .prose-essay li + li {
    margin-top: 0.5rem;
  }
  .prose-essay blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-fg);
  }
  .prose-essay a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .prose-essay code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: rgba(0, 0, 0, 0.04);
    padding: 0.15em 0.35em;
    border-radius: 4px;
  }
  .prose-essay pre {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--color-fg);
    color: var(--color-bg);
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    overflow-x: auto;
  }
  .prose-essay pre code {
    background: transparent;
    padding: 0;
  }
  .prose-essay hr {
    border: 0;
    border-top: 1px solid var(--color-line);
    margin: 2.5rem 0;
  }
  .prose-essay strong {
    color: var(--color-fg);
    font-weight: 600;
  }
  .prose-essay table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
  }
  .prose-essay thead {
    background: rgba(0, 0, 0, 0.025);
  }
  .prose-essay th,
  .prose-essay td {
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
    color: var(--color-muted);
  }
  .prose-essay th {
    font-weight: 600;
    color: var(--color-fg);
  }
  .prose-essay tbody td:first-child {
    color: var(--color-fg);
    font-weight: 500;
  }
  @media (max-width: 640px) {
    .prose-essay table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
