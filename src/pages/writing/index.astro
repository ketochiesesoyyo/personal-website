---
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import SectionEyebrow from "~/components/SectionEyebrow.astro";
import { site } from "~/site.config";

const all = await getCollection("posts", ({ data }) => !data.draft);
const posts = all.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const writingUrl = `${siteUrl}/writing`;
const description = "Long-form essays and case studies on AI, engineering, and where things are going.";

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${writingUrl}#blog`,
  url: writingUrl,
  name: `${site.studio} — Writing`,
  description,
  inLanguage: "en",
  author: { "@id": `${siteUrl}/#person` },
  publisher: { "@id": `${siteUrl}/#studio` },
  isPartOf: { "@id": `${siteUrl}/#website` },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    "@id": `${siteUrl}/writing/${post.id}/#article`,
    headline: post.data.title,
    description: post.data.excerpt,
    url: `${siteUrl}/writing/${post.id}/`,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    articleSection: post.data.topic,
    author: { "@id": `${siteUrl}/#person` },
  })),
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${writingUrl}#itemlist`,
  name: `${site.studio} — Writing index`,
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  numberOfItems: posts.length,
  itemListElement: posts.map((post, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${siteUrl}/writing/${post.id}/`,
    name: post.data.title,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Writing", item: `${writingUrl}/` },
  ],
};

const jsonLd = [blogSchema, itemListSchema, breadcrumbSchema];
---

<Base
  title="Writing"
  description={description}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-4xl px-6 pt-20 pb-32">
    <header class="mb-16">
      <SectionEyebrow class="mb-4">Writing</SectionEyebrow>
      <h1 class="font-display text-5xl md:text-6xl tracking-tight leading-[1.05]">
        Essays on AI, building, and where things are going.
      </h1>
      <p class="mt-6 text-lg text-[color:var(--color-muted)] max-w-2xl leading-relaxed">
        Long-form research and reflection. Case studies on what just shifted in the AI/tech stack and what it actually means for operators building today.
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="text-[color:var(--color-muted)] py-12">First piece is in research. Check back soon.</p>
    ) : (
      <ul class="border-t border-[color:var(--color-line)]">
        {posts.map((post) => (
          <li>
            <a
              href={`/writing/${post.id}/`}
              class="group block py-7 md:py-8 border-b border-[color:var(--color-line)]"
            >
              <div class="flex items-start justify-between gap-6">
                <div class="flex-1 min-w-0">
                  <div class="text-xs text-[color:var(--color-muted)] uppercase tracking-[0.18em] mb-2">
                    {formatDate(post.data.publishedAt)} · {post.data.topic}
                  </div>
                  <h2 class="font-display text-2xl md:text-3xl tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="text-[color:var(--color-muted)] mt-2 max-w-2xl leading-relaxed">
                    {post.data.excerpt}
                  </p>
                </div>
                <div class="font-display text-xl text-[color:var(--color-muted)] group-hover:text-[color:var(--color-accent)] group-hover:translate-x-1 transition shrink-0 mt-1">
                  →
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="mt-16 flex items-center justify-between text-sm">
      <a href="/" class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">← Home</a>
      <a href="/rss.xml" class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">RSS feed</a>
    </div>
  </section>
</Base>
