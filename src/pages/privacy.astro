---
import Base from "~/layouts/Base.astro";
import SectionEyebrow from "~/components/SectionEyebrow.astro";
import { site } from "~/site.config";

const lastUpdated = "April 29, 2026";

const shortVersion = [
  "I don't run advertising or marketing trackers on this site.",
  "I don't sell, rent, or share your personal data with third parties for their own marketing.",
  "The site is a static website hosted on Vercel. Server logs and font requests generate the only meaningful data exhaust.",
  "If you email me, I keep your email and message so I can reply and follow up.",
];

const dataYouSend = [
  {
    title: "Server logs (via Vercel)",
    body: "The Site is hosted on Vercel. As with any web host, Vercel automatically logs basic technical information for each request, including IP address, browser user agent, requested URL, referrer, and timestamp. These logs are used to operate the Site, prevent abuse, and diagnose errors. They are retained according to Vercel's standard retention policies.",
    link: { label: "Vercel's privacy policy", href: "https://vercel.com/legal/privacy-policy" },
  },
  {
    title: "Fonts (via Google Fonts)",
    body: "The Site loads typography from Google Fonts. When your browser fetches a font file, Google receives the request, which includes your IP address and user agent. Google states that font requests are not used to build user profiles or for ad targeting. If you'd rather block these requests, the site will still render in fallback fonts.",
    link: { label: "Google Fonts' privacy FAQ", href: "https://developers.google.com/fonts/faq/privacy" },
  },
  {
    title: "Email correspondence",
    body: `If you email ${site.email} to discuss a project or ask a question, your email address and the contents of your message are stored in my email provider's systems so I can read and reply. I keep correspondence as long as it's relevant to our working relationship and a reasonable period afterward.`,
  },
];

const notCollected = [
  "No analytics platform is currently installed.",
  "No advertising or remarketing pixels.",
  "No first-party or third-party tracking cookies.",
  "No web forms collecting personal data (contact happens via your email client, on your terms).",
];

const whyCollect = [
  { label: "To operate and secure the Site", body: "Server logs let the host detect abuse and diagnose outages." },
  { label: "To respond to you", body: "If you email me, I need your message to reply." },
  { label: "To comply with legal obligations", body: "Retention of records where the law requires it." },
];

const sharedWith = [
  { name: "Vercel", body: "Hosting and edge infrastructure." },
  { name: "Google Fonts", body: "Typography delivery." },
  { name: "My email provider", body: "Receives and stores correspondence you initiate." },
];

const yourRights = [
  "Ask what personal information I hold about you.",
  "Ask me to correct inaccurate data.",
  "Ask me to delete your data, subject to legal retention obligations.",
  "Withdraw consent or object to certain processing.",
  "Lodge a complaint with your local data protection authority (in Mexico, the INAI; in the EU/UK, your national supervisory authority; in California, the CPPA).",
];
---

<Base
  title="Privacy Policy"
  description="How henrickf.com handles your data. Plain language, minimal collection, no tracking."
>
  <section class="mx-auto max-w-6xl px-6 pt-32 pb-16">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <SectionEyebrow class="mb-4">Privacy</SectionEyebrow>
        <div class="text-xs text-[color:var(--color-muted)] uppercase tracking-[0.2em]">
          Last updated · {lastUpdated}
        </div>
      </div>
      <div class="md:col-span-2">
        <h1 class="font-display text-5xl md:text-6xl tracking-tight leading-[1.05]">
          Privacy Policy
        </h1>
        <p class="mt-6 text-lg md:text-xl text-[color:var(--color-muted)] leading-relaxed max-w-2xl">
          What data this site collects, why, and what I do with it. The short version: very little, and nothing for advertising.
        </p>
        <p class="mt-6 text-lg leading-relaxed max-w-2xl">
          This Privacy Policy describes how <a href={site.url} class="text-[color:var(--color-accent)] underline underline-offset-4">henrickf.com</a> (the "Site") collects, uses, and protects information when you visit. The Site is operated by {site.founder}. Contact: <a href={`mailto:${site.email}`} class="text-[color:var(--color-accent)] underline underline-offset-4">{site.email}</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">01</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">The short version</h2>
      </div>
      <div class="md:col-span-2 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <ul class="space-y-3 list-disc pl-6">
          {shortVersion.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">02</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">What I collect</h2>
      </div>
      <div class="md:col-span-2 space-y-8 text-lg leading-relaxed text-[color:var(--color-muted)]">
        {dataYouSend.map((item) => (
          <div class="space-y-3">
            <h3 class="font-display text-xl text-[color:var(--color-fg)]">{item.title}</h3>
            <p>{item.body}{item.link && (<> See <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="text-[color:var(--color-accent)] underline underline-offset-4">{item.link.label}</a>.</>)}</p>
          </div>
        ))}
        <div class="space-y-3 pt-4 border-t border-[color:var(--color-line)]">
          <h3 class="font-display text-xl text-[color:var(--color-fg)]">What the Site does NOT collect</h3>
          <ul class="space-y-2 list-disc pl-6">
            {notCollected.map((line) => <li>{line}</li>)}
          </ul>
          <p class="pt-2">If I add analytics later (for example, a privacy-respecting product like Plausible or Fathom), I'll update this page and disclose what's collected.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">03</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Why I collect it</h2>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <ul class="space-y-3">
          {whyCollect.map((item) => (
            <li><span class="text-[color:var(--color-fg)] font-medium">{item.label}.</span> {item.body}</li>
          ))}
        </ul>
        <p>I do not use any of this data for behavioral advertising, profiling for marketing, or automated decision-making about you.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">04</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Sharing</h2>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <p>I share information only with service providers strictly necessary to run the Site:</p>
        <ul class="space-y-3">
          {sharedWith.map((item) => (
            <li><span class="text-[color:var(--color-fg)] font-medium">{item.name}.</span> {item.body}</li>
          ))}
        </ul>
        <p>I do not sell your data. I do not share it with advertising networks. If a legal authority compels disclosure under valid process, I'll comply with what's actually required and nothing more.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">05</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Your rights</h2>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <p>Depending on where you live, you may have the right to:</p>
        <ul class="space-y-2 list-disc pl-6">
          {yourRights.map((line) => <li>{line}</li>)}
        </ul>
        <p>To exercise any of these rights, email <a href={`mailto:${site.email}`} class="text-[color:var(--color-accent)] underline underline-offset-4">{site.email}</a>. I'll respond within a reasonable time and at no cost, except where the law allows otherwise (e.g., manifestly unfounded or repeated requests).</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">06</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">International transfers</h2>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <p>The Site's hosting and email infrastructure may store and process data outside your country (typically in the United States or EU regions, depending on the provider). Where required, transfers rely on the providers' standard contractual clauses or equivalent safeguards.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">07</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Children &amp; security</h2>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <p>The Site is not directed to children under 13 (or the equivalent minimum age in your jurisdiction). I don't knowingly collect personal information from children. If you believe a child has provided personal data, contact me and I'll delete it.</p>
        <p>I use providers with industry-standard security practices (HTTPS in transit, hosted infrastructure with managed access controls). No system is perfectly secure; if a breach affecting your data occurs, I'll notify affected users in line with applicable law.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">08</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Changes</h2>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <p>I may update this policy when the Site changes or when the law requires it. The Last updated date at the top of this page reflects the most recent revision. Material changes will be flagged on the home page or by direct notice where appropriate.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <SectionEyebrow class="mb-3">Contact</SectionEyebrow>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Questions?</h2>
      </div>
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
        <p>Questions about privacy or your rights: <a href={`mailto:${site.email}`} class="text-[color:var(--color-accent)] underline underline-offset-4">{site.email}</a>.</p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-12 border-t border-[color:var(--color-line)] flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-sm">
    <a href="/" class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">← Home</a>
    <a href="/terms" class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">Terms of Use →</a>
  </div>
</Base>
