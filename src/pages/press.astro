---
import Base from "~/layouts/Base.astro";
import SectionEyebrow from "~/components/SectionEyebrow.astro";
import { site } from "~/site.config";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";

const bios = {
  short:
    "Henrick F. is an independent product and AI builder. He is a partner at Clearframe Labs and Director of Operations & GTM at MatchWise, an AI applicant tracking system.",
  medium:
    "Henrick F. is an independent product and AI builder based in Mexico City. He builds AI automations and custom applications for B2B companies, with six-plus years of operating depth at LATAM venture-backed startups including Jeeves (a16z, YC) and Bedu (Lottus Education). Today he is a partner at Clearframe Labs, the AI product studio, and Director of Operations & GTM at MatchWise. MBA from IPADE Business School; BS in Industrial Engineering from Universidad Iberoamericana.",
  long: [
    "Henrick F. is an independent product and AI builder based in Mexico City. He builds AI automations and custom applications for B2B companies, working at the overlap between go-to-market operations and product engineering. Today he is a partner at Clearframe Labs, the AI product studio, and Director of Operations & GTM at MatchWise, an AI applicant tracking system.",
    "Before going independent, he spent six-plus years scaling revenue and operations at venture-backed fintech, edtech, and AI startups across LATAM. As Director of Strategy & Operations at Bedu (Lottus Education, one of Mexico's leading higher-education groups), he owned the B2B P&L and managed enterprise accounts with HSBC, Santander, Novartis, and Accenture. Earlier he was Head of Sales for Mexico at Jeeves (YC 2020, a16z), where he led a 12-person team and contributed to the Series C deck that raised approximately $180M at a $2.1B valuation. He started his career as a fintech consultant at KoreFusion, advising 100-plus payments and fintech companies across LATAM, EMEA, and the US.",
    "He holds an MBA from IPADE Business School and a BS in Industrial Engineering from Universidad Iberoamericana. He works in English and Spanish.",
  ],
};

const keyFacts = [
  { label: "Based in", value: "Mexico City, Mexico" },
  { label: "Working with", value: "B2B companies globally" },
  { label: "Current roles", value: "Partner at Clearframe Labs · Director of Operations & GTM, MatchWise · Independent builder" },
  { label: "Languages", value: "English (fluent), Spanish (native)" },
  { label: "Education", value: "MBA, IPADE Business School · BS Industrial Engineering, Universidad Iberoamericana" },
  { label: "Studio", value: "Clearframe Labs (clearframelabs.co)" },
  { label: "Product", value: "MatchWise (AI applicant tracking system)" },
];

const speakingTopics = [
  {
    title: "AI implementation for B2B operators",
    body: "Why most AI initiatives at growing companies fail to ship, and what changes when the person scoping the build has run the workflow underneath it.",
  },
  {
    title: "The operator-builder overlap",
    body: "Why ex-operators ship better software for operational problems than career engineers, and where that advantage breaks down.",
  },
  {
    title: "GTM and revenue operations in LATAM",
    body: "Selling B2B in LATAM is different. Enterprise cycles, regulatory drag, currency dynamics, and what actually moves a deal forward.",
  },
  {
    title: "Founder-led vs studio engagements",
    body: "When a solo builder is faster than a team and when the studio model wins. The economics, the scope ceilings, and how to spot the difference.",
  },
  {
    title: "Practical AI workflows that save money",
    body: "Case studies from MatchWise (60% inference-cost reduction) and Service Core (20+ hours per week eliminated) on choosing the cheapest tool that actually fixes the problem.",
  },
];

const quotes = [
  "Most AI builders don't have a $15M book of business in their past. Most GTM operators can't ship the tool that fixes the problem they just diagnosed. The overlap is where I work.",
  "AI without a real problem under it is a demo.",
  "Stop writing decks about the build. Build the thing.",
  "Diagnose before prescribing. Half the engagements I take start with the wrong problem statement.",
];

const assets = [
  {
    label: "Headshot, JPG",
    note: "Square portrait. Suitable for editorial use.",
    href: "/henrick.jpg",
    download: "henrick-farias-headshot.jpg",
  },
  {
    label: "Open Graph card, PNG",
    note: "1200×630 social card with brand mark.",
    href: "/og-default.png",
    download: "henrick-farias-og.png",
  },
  {
    label: "Site favicon, SVG",
    note: "Brand mark used across henrickf.com.",
    href: "/favicon.svg",
    download: "henrick-farias-mark.svg",
  },
];

const description = `Press kit for ${site.founder}. Bios, headshot, key facts, speaking topics, and quotes for journalists, podcasters, and event organizers.`;

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${siteUrl}/press#page`,
  url: `${siteUrl}/press`,
  name: `Press kit — ${site.founder}`,
  description,
  about: { "@id": `${siteUrl}/#person` },
  mainEntity: { "@id": `${siteUrl}/#person` },
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#studio` },
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["#short-bio", "#medium-bio"],
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Press", item: `${siteUrl}/press` },
  ],
};
---

<Base title="Press kit" description={description} jsonLd={[profilePageSchema, breadcrumbSchema]}>
  <section class="mx-auto max-w-6xl px-6 pt-32 pb-16">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <SectionEyebrow class="mb-4">Press kit</SectionEyebrow>
        <img
          src="/henrick.jpg"
          alt={`Portrait of ${site.founder}`}
          width="240"
          height="240"
          loading="lazy"
          class="mt-2 w-40 h-40 md:w-56 md:h-56 rounded-full object-cover border border-[color:var(--color-line)]"
        />
        <div class="mt-6 text-xs text-[color:var(--color-muted)] uppercase tracking-[0.2em]">
          For journalists, podcasters, event organizers.
        </div>
      </div>
      <div class="md:col-span-2">
        <h1 class="font-display text-5xl md:text-6xl tracking-tight leading-[1.05]">
          {site.founder}, press kit.
        </h1>
        <p class="mt-6 text-lg md:text-xl text-[color:var(--color-muted)] leading-relaxed max-w-2xl">
          Bios at three lengths, key facts, speaking topics, and assets. Everything here is free to use without permission. For interview requests or quotes on a specific topic, please email and mention the publication or show.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={`mailto:${site.email}?subject=Press%20inquiry`}
            class="px-6 py-3 rounded-full bg-[color:var(--color-fg)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-accent)] hover:text-[color:var(--color-bg)] transition-colors"
          >
            Press contact: {site.email}
          </a>
          <a
            href={site.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full border border-[color:var(--color-line)] hover:border-[color:var(--color-fg)] transition-colors"
          >
            LinkedIn →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">01</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Bios</h2>
        <p class="mt-4 text-[color:var(--color-muted)] leading-relaxed">
          Three lengths. Copy whichever fits.
        </p>
      </div>
      <div class="md:col-span-2 space-y-8">
        <article class="rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)] p-6 md:p-8">
          <div class="flex items-center justify-between gap-4 mb-4">
            <div class="text-xs uppercase tracking-[0.18em] text-[color:var(--color-muted)]">Short · ~30 words</div>
            <button
              type="button"
              class="copy-btn text-xs uppercase tracking-[0.18em] text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] transition-colors"
              data-copy-target="short-bio"
            >
              Copy
            </button>
          </div>
          <p id="short-bio" class="text-lg leading-relaxed">{bios.short}</p>
        </article>

        <article class="rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)] p-6 md:p-8">
          <div class="flex items-center justify-between gap-4 mb-4">
            <div class="text-xs uppercase tracking-[0.18em] text-[color:var(--color-muted)]">Medium · ~75 words</div>
            <button
              type="button"
              class="copy-btn text-xs uppercase tracking-[0.18em] text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] transition-colors"
              data-copy-target="medium-bio"
            >
              Copy
            </button>
          </div>
          <p id="medium-bio" class="text-lg leading-relaxed">{bios.medium}</p>
        </article>

        <article class="rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)] p-6 md:p-8">
          <div class="flex items-center justify-between gap-4 mb-4">
            <div class="text-xs uppercase tracking-[0.18em] text-[color:var(--color-muted)]">Long · ~200 words</div>
            <button
              type="button"
              class="copy-btn text-xs uppercase tracking-[0.18em] text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] transition-colors"
              data-copy-target="long-bio"
            >
              Copy
            </button>
          </div>
          <div id="long-bio" class="text-lg leading-relaxed space-y-4">
            {bios.long.map((p) => <p>{p}</p>)}
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">02</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Key facts</h2>
      </div>
      <div class="md:col-span-2">
        <dl class="divide-y divide-[color:var(--color-line)]">
          {keyFacts.map((fact) => (
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 py-4">
              <dt class="text-xs uppercase tracking-[0.18em] text-[color:var(--color-muted)] pt-1">{fact.label}</dt>
              <dd class="sm:col-span-2 text-lg leading-relaxed">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="max-w-2xl">
      <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">03</div>
      <h2 class="font-display text-3xl md:text-4xl tracking-tight">Speaking topics</h2>
      <p class="mt-4 text-[color:var(--color-muted)] leading-relaxed">
        Areas I cover for podcasts, panels, and written interviews.
      </p>
    </div>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 text-lg leading-relaxed text-[color:var(--color-muted)]">
      {speakingTopics.map((topic) => (
        <article class="rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)] p-6 md:p-8">
          <h3 class="font-display text-xl md:text-2xl tracking-tight text-[color:var(--color-fg)]">{topic.title}</h3>
          <p class="mt-3">{topic.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">04</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Quotes</h2>
        <p class="mt-4 text-[color:var(--color-muted)] leading-relaxed">
          Lines you're welcome to pull and attribute. For something specific to your story, just ask.
        </p>
      </div>
      <div class="md:col-span-2 space-y-6">
        {quotes.map((q) => (
          <blockquote class="border-l-2 border-[color:var(--color-accent)] pl-5 md:pl-6">
            <p class="font-display text-xl md:text-2xl italic leading-snug text-[color:var(--color-fg)]">"{q}"</p>
            <footer class="mt-3 text-sm text-[color:var(--color-muted)]">— {site.founder}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="grid md:grid-cols-3 gap-12">
      <div>
        <div class="font-display text-5xl text-[color:var(--color-accent)] mb-4">05</div>
        <h2 class="font-display text-3xl md:text-4xl tracking-tight">Assets</h2>
        <p class="mt-4 text-[color:var(--color-muted)] leading-relaxed">
          Free to use without permission. Please don't crop or recolor the headshot.
        </p>
      </div>
      <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-5">
        {assets.map((asset) => (
          <a
            href={asset.href}
            download={asset.download}
            class="rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-bg)] p-5 md:p-6 transition-colors hover:border-[color:var(--color-fg)]/40 flex flex-col gap-3"
          >
            <div class="aspect-square w-full rounded-xl bg-[color:var(--color-card)] overflow-hidden flex items-center justify-center">
              <img src={asset.href} alt="" loading="lazy" class="w-full h-full object-cover" />
            </div>
            <div>
              <div class="font-display text-base text-[color:var(--color-fg)]">{asset.label}</div>
              <div class="mt-1 text-sm text-[color:var(--color-muted)]">{asset.note}</div>
            </div>
            <div class="mt-auto text-xs uppercase tracking-[0.18em] text-[color:var(--color-accent)]">Download ↓</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 border-t border-[color:var(--color-line)]">
    <div class="rounded-3xl bg-[color:var(--color-fg)] text-[color:var(--color-bg)] p-10 md:p-16">
      <SectionEyebrow class="mb-4">Press contact</SectionEyebrow>
      <h2 class="font-display text-4xl md:text-6xl tracking-tight max-w-3xl">
        Writing a story? <span class="italic opacity-70">Get in touch.</span>
      </h2>
      <p class="mt-6 max-w-2xl opacity-70 text-lg leading-relaxed">
        For interview requests, quote checks, or background on a specific topic, email with the publication or show and your deadline. I usually reply within one business day.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={`mailto:${site.email}?subject=Press%20inquiry`}
          class="px-6 py-3 rounded-full bg-[color:var(--color-bg)] text-[color:var(--color-fg)] hover:bg-[color:var(--color-accent)] hover:text-[color:var(--color-bg)] transition-colors"
        >
          {site.email}
        </a>
        <a
          href="/about"
          class="px-6 py-3 rounded-full border border-[color:var(--color-bg)]/30 hover:border-[color:var(--color-bg)] transition-colors"
        >
          More background →
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 py-12 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between text-sm">
    <a href="/" class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">← Home</a>
    <a href="/about" class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]">About →</a>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const targetId = btn.dataset.copyTarget;
      if (!targetId) return;
      const node = document.getElementById(targetId);
      if (!node) return;
      const text = node.innerText.trim();
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => {
          btn.textContent = original;
        }, 1600);
      } catch {
        btn.textContent = "Copy failed";
      }
    });
  });
</script>
