---
import { site } from "~/site.config";
import footerCopy from "~/content/homepage/footer.json";
const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-line)] mt-32">
  <div class="mx-auto max-w-6xl px-6 py-12 grid gap-8 md:grid-cols-4 text-sm">
    <div>
      <div class="font-display text-lg">{site.studio}</div>
      <p class="text-[color:var(--color-muted)] mt-2 max-w-xs">{footerCopy.bio}</p>
    </div>
    <div>
      <div class="text-[color:var(--color-muted)] mb-3">Site</div>
      <ul class="space-y-2">
        {site.nav.map((item) => (
          <li><a href={item.href} class="hover:text-[color:var(--color-accent)]">{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <div class="text-[color:var(--color-muted)] mb-3">Thoughts</div>
      <ul class="space-y-2">
        <li><a href="/writing/" class="hover:text-[color:var(--color-accent)]">Writing</a></li>
        <li><a href="/rss.xml" class="hover:text-[color:var(--color-accent)]">RSS</a></li>
      </ul>
    </div>
    <div>
      <div class="text-[color:var(--color-muted)] mb-3">Elsewhere</div>
      <ul class="space-y-2">
        <li><a href={`mailto:${site.email}`} class="hover:text-[color:var(--color-accent)]">{site.email}</a></li>
        <li><a href={site.socials.linkedin} class="hover:text-[color:var(--color-accent)]">LinkedIn</a></li>
        <li><a href={site.socials.github} class="hover:text-[color:var(--color-accent)]">GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-[color:var(--color-line)]">
    <div class="mx-auto max-w-6xl px-6 py-6 grid grid-cols-1 sm:grid-cols-3 items-center gap-3 text-xs text-[color:var(--color-muted)]">
      <span class="sm:justify-self-start">© {year} {site.studio}.</span>
      <span class="sm:justify-self-center">{footerCopy.solidarity}</span>
      <div class="flex items-center gap-4 sm:justify-self-end">
        <a href="/terms/" class="hover:text-[color:var(--color-accent)]">Terms</a>
        <a href="/privacy/" class="hover:text-[color:var(--color-accent)]">Privacy</a>
        <span>Built by {site.founder}.</span>
      </div>
    </div>
  </div>
</footer>
