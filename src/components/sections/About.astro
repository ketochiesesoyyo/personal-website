---
import SectionEyebrow from "~/components/SectionEyebrow.astro";
import about from "~/content/homepage/about.json";
---

<section id="about" class="mx-auto max-w-6xl px-6 py-24 border-t border-[color:var(--color-line)]">
  <div class="grid md:grid-cols-3 gap-12">
    <div>
      <SectionEyebrow class="mb-3">{about.eyebrow}</SectionEyebrow>
      <h2 class="font-display text-4xl md:text-5xl tracking-tight">{about.heading}</h2>
      <img
        src={about.portrait}
        alt={about.portraitAlt}
        width="240"
        height="240"
        loading="lazy"
        class="mt-8 w-40 h-40 md:w-56 md:h-56 rounded-full object-cover border border-[color:var(--color-line)]"
      />
    </div>
    <div class="md:col-span-2 space-y-6 text-lg leading-relaxed">
      {about.paragraphs.map((p, i) => (
        <p class={i === 0 ? "" : "text-[color:var(--color-muted)]"}>{p}</p>
      ))}
    </div>
  </div>
</section>
