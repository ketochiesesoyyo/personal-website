---
import DottedMap from "dotted-map";
import SectionEyebrow from "~/components/SectionEyebrow.astro";
import locations from "~/content/homepage/locations.json";

const WORLD_REGION = {
  lat: { min: -56, max: 71 },
  lng: { min: -168, max: 168 },
};

const map = new DottedMap({
  height: 60,
  grid: "diagonal",
  region: WORLD_REGION,
});

const positioned = locations.items.map((item) => {
  const pin = map.getPin({ lat: item.lat, lng: item.lng });
  return { ...item, pin };
});

const svgMap = map.getSVG({
  radius: 0.22,
  color: "currentColor",
  shape: "circle",
  backgroundColor: "transparent",
});

const mapWidth = map.image.width;
const mapHeight = map.image.height;
---

<section
  id="where-i-operate"
  class="mx-auto max-w-6xl px-6 py-24 border-t border-[color:var(--color-line)]"
>
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
    <div>
      <SectionEyebrow class="mb-3">{locations.eyebrow}</SectionEyebrow>
      <h2 class="font-display text-4xl md:text-5xl tracking-tight">{locations.heading}</h2>
    </div>
    <p class="text-[color:var(--color-muted)] max-w-md">{locations.intro}</p>
  </div>

  <div
    class="hf-map-wrap relative w-full text-[color:var(--color-muted)]"
    style={`aspect-ratio: ${mapWidth} / ${mapHeight}`}
  >
    <div class="hf-map-svg" set:html={svgMap} aria-hidden="true" />

    <ul class="hf-map-pins absolute inset-0 m-0 p-0 list-none pointer-events-none">
      {positioned.map((item) => {
        if (!item.pin) return null;
        const x = (item.pin.x / mapWidth) * 100;
        const y = (item.pin.y / mapHeight) * 100;
        return (
          <li
            class="absolute -translate-x-1/2 -translate-y-1/2"
            style={`left:${x}%;top:${y}%`}
          >
            <span class="hf-pulse" aria-hidden="true"></span>
            <span class="hf-dot" aria-hidden="true"></span>
            <span class="hf-label">{item.label}<span class="opacity-60">, {item.country}</span></span>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style is:global>
  .hf-map-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: color-mix(in oklab, var(--color-muted) 55%, transparent);
  }
  .hf-map-svg svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hf-pulse {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    transform: translate(-50%, -50%);
    background: color-mix(in oklab, var(--color-accent) 40%, transparent);
    animation: hf-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .hf-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 9999px;
    transform: translate(-50%, -50%);
    background: var(--color-accent);
    box-shadow: 0 0 10px color-mix(in oklab, var(--color-accent) 60%, transparent);
  }
  .hf-label {
    position: absolute;
    left: 14px;
    top: -6px;
    white-space: nowrap;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg);
    background: color-mix(in oklab, var(--color-bg) 80%, transparent);
    padding: 2px 6px;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    pointer-events: auto;
  }
  @keyframes hf-ping {
    0% { transform: translate(-50%, -50%) scale(0.4); opacity: 0.8; }
    80%, 100% { transform: translate(-50%, -50%) scale(2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hf-pulse { animation: none; opacity: 0.4; }
  }
</style>
