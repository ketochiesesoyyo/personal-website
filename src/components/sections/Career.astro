---
import SectionEyebrow from "~/components/SectionEyebrow.astro";
import career from "~/content/homepage/career.json";
---

<section id="career" class="mx-auto max-w-6xl px-6 py-24 border-t border-[color:var(--color-line)]">
  <div class="grid md:grid-cols-3 gap-12">
    <div>
      <SectionEyebrow class="mb-3">{career.eyebrow}</SectionEyebrow>
      <h2 class="font-display text-4xl md:text-5xl tracking-tight">{career.heading}</h2>
      <p class="mt-6 text-[color:var(--color-muted)] leading-relaxed">
        {career.education}
      </p>
    </div>
    <div class="md:col-span-2 space-y-8">
      {career.roles.map((r) => (
        <div class="grid grid-cols-[120px_1fr] md:grid-cols-[160px_1fr] gap-6 pb-8 border-b border-[color:var(--color-line)] last:border-0">
          <div class="text-sm text-[color:var(--color-muted)]">{r.year}</div>
          <div>
            <div class="font-display text-xl">
              {r.title} <span class="text-[color:var(--color-muted)]">— {r.company}</span>
            </div>
            <p class="text-[color:var(--color-muted)] mt-2 leading-relaxed">{r.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
