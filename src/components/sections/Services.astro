---
import SectionEyebrow from "~/components/SectionEyebrow.astro";
import services from "~/content/homepage/services.json";

const ICONS: Record<string, string> = {
  hammer: `<path d="m15 12-8.5 8.5c-.83.83-2.17.83-3 0 0 0 0 0 0 0a2.12 2.12 0 0 1 0-3L12 9"/><path d="M17.64 15 22 10.64"/><path d="m20.91 11.7-1.25-1.25c-.6-.6-.93-1.4-.93-2.25v-.86L16.01 4.6a5.56 5.56 0 0 0-3.94-1.64H9l.92.82A6.18 6.18 0 0 1 12 8.4v1.56l2 2h2.47l2.26 1.91"/>`,
  zap: `<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>`,
  compass: `<path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"/><circle cx="12" cy="12" r="10"/>`,
  searchCheck: `<path d="m8 11 2 2 4-4"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>`,
};
---

<section id="services" class="mx-auto max-w-6xl px-6 py-24 border-t border-[color:var(--color-line)]">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
    <div>
      <SectionEyebrow class="mb-3">{services.eyebrow}</SectionEyebrow>
      <h2 class="font-display text-4xl md:text-5xl tracking-tight">{services.heading}</h2>
    </div>
    <p class="text-[color:var(--color-muted)] max-w-md">
      {services.intro}
    </p>
  </div>
  <div class="grid md:grid-cols-2 gap-6">
    {services.items.map((s) => (
      <div class="border border-[color:var(--color-line)] rounded-2xl p-8 bg-[color:var(--color-card)]">
        <div class="text-xs text-[color:var(--color-muted)] uppercase tracking-[0.18em] mb-4">{s.format}</div>
        <div class="flex items-center gap-3 mb-3">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-[color:var(--color-accent)] shrink-0"
            aria-hidden="true"
            set:html={ICONS[s.icon] ?? ""}
          />
          <div class="font-display text-2xl">{s.title}</div>
        </div>
        <p class="text-[color:var(--color-muted)] leading-relaxed">{s.description}</p>
      </div>
    ))}
  </div>
  <div class="mt-12 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-t border-[color:var(--color-line)] pt-8">
    <p class="text-[color:var(--color-muted)]">{services.ctaText}</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <a
        href="/services"
        class="text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)] underline underline-offset-4 decoration-[color:var(--color-line)] hover:decoration-[color:var(--color-accent)]"
      >
        See engagement details →
      </a>
      <a
        href={services.ctaButton.href}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[color:var(--color-fg)] text-[color:var(--color-bg)] hover:bg-[color:var(--color-accent)] transition-colors shrink-0"
      >
        {services.ctaButton.label}
      </a>
    </div>
  </div>
</section>
