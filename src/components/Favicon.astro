---
interface Props {
  url?: string;
  size?: number;
  alt?: string;
  class?: string;
}

const { url, size = 24, alt = "", class: className = "" } = Astro.props;

let host: string | null = null;
if (url) {
  try {
    host = new URL(url).hostname;
  } catch {
    host = null;
  }
}

const src = host ? `https://www.google.com/s2/favicons?domain=${host}&sz=64` : null;
---

{src && (
  <img
    src={src}
    alt={alt}
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
    class:list={["rounded-md border border-[color:var(--color-line)] bg-[color:var(--color-card)]", className]}
    style={`width:${size}px;height:${size}px`}
  />
)}
